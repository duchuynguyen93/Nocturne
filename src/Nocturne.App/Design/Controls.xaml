<!--
  Control styles for the player surface.

  WinUI's Fluent defaults are built for an app window, not for chrome laid over
  moving video: they carry background fills, focus plates, and hover rectangles
  that all read as boxes floating on the picture. Every style here strips the
  control back to its glyph and re-adds only what a viewer needs to see —
  which, over video, is contrast against an unpredictable background.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Design/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      A transport glyph button: no chrome at rest, a faint disc on hover, and
      the accent colour on press. The disc rather than a rectangle is what keeps
      it from reading as a Windows toolbar dropped onto a film.
    -->
    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource TransportButtonSize}" />
        <Setter Property="Height" Value="{StaticResource TransportButtonSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Ellipse
                            x:Name="HoverDisc"
                            Fill="#1FFFFFFF"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverDisc"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverDisc"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Presenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.7"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Presenter"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.35"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The play button. The one filled amber shape on the surface, with a dark
      glyph punched out of it — the single strongest signal in the whole design,
      and the reason the rest of the chrome can afford to be this quiet.
    -->
    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Width" Value="{StaticResource TransportPlayButtonSize}" />
        <Setter Property="Height" Value="{StaticResource TransportPlayButtonSize}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Disc" Fill="{StaticResource AccentBrush}" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                            Storyboard.TargetName="Disc"
                                            Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame
                                                KeyTime="0"
                                                Value="{StaticResource AccentHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Disc"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.8"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Disc"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.3"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The seek bar. A 4px track that grows to 6px under the pointer, an amber
      fill, and a thumb that only appears on hover. Hiding the thumb at rest is
      what keeps a thin bright line across the bottom of the picture instead of
      a control.
    -->
    <Style x:Key="SeekBarStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#4DFFFFFF" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="StepFrequency" Value="0.0001" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="RootGrid" Background="Transparent" Padding="0,8">
                        <Grid x:Name="HorizontalTemplate" Height="{StaticResource SeekTrackHoverHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle
                                x:Name="HorizontalTrackRect"
                                Grid.ColumnSpan="3"
                                Height="{StaticResource SeekTrackHeight}"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{TemplateBinding Background}"
                                VerticalAlignment="Center" />

                            <Rectangle
                                x:Name="HorizontalDecreaseRect"
                                Grid.Column="0"
                                Height="{StaticResource SeekTrackHeight}"
                                RadiusX="2"
                                RadiusY="2"
                                Fill="{TemplateBinding Foreground}"
                                VerticalAlignment="Center" />

                            <Thumb
                                x:Name="HorizontalThumb"
                                Grid.Column="1"
                                Width="12"
                                Height="12"
                                Opacity="0"
                                AutomationProperties.AccessibilityView="Raw"
                                DataContext="{TemplateBinding Value}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{StaticResource AccentBrush}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HorizontalThumb"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HorizontalThumb"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HorizontalTemplate"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.35"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The mono pill that carries the file name and timecode. -->
    <Style x:Key="OverlayChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="TimecodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TextSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <!--
          Fixed-width digits come from the font itself, not from an OpenType
          feature: WinUI has no FontFeatures property and no Typography attached
          properties, so the monospace family in MonoFontFamily is what stops
          the elapsed field jittering horizontally as it counts. Do not swap
          this style onto a proportional face.
        -->
    </Style>

</ResourceDictionary>
