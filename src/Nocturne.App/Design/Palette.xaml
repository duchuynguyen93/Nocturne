<!--
  The Nocturne palette.

  These values are lifted from Lumen Player's own design tokens, read out of the
  computed styles on lumenplayer.net: a near-black neutral ramp named "ink", a
  single amber accent, and nothing else. The discipline is the point — one
  accent hue means the eye goes to the play button and the progress fill and
  nowhere else, which is what a player watched in a dark room needs.

  The app is dark-only by design. A media player's chrome sits beside the image
  it is showing; a light chrome changes the perceived black level of the video
  next to it. See docs/UI_SPEC.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral ramp. Lower numbers are darker; 950 is the window background. -->
    <Color x:Key="Ink950">#FF0A0A0B</Color>
    <Color x:Key="Ink900">#FF111114</Color>
    <Color x:Key="Ink850">#FF16161B</Color>
    <Color x:Key="Ink800">#FF1A1A1F</Color>
    <Color x:Key="Ink700">#FF26262E</Color>
    <Color x:Key="Ink600">#FF3D3D48</Color>
    <Color x:Key="Ink500">#FF6B6B7A</Color>
    <Color x:Key="Ink400">#FF828292</Color>
    <Color x:Key="Ink300">#FFA0A0AD</Color>
    <Color x:Key="Ink200">#FFC7C7D1</Color>
    <Color x:Key="Ink100">#FFE8E8ED</Color>
    <Color x:Key="Ink50">#FFF8F8FA</Color>

    <!-- The single accent. 500 is the resting state, 400 is hover. -->
    <Color x:Key="Amber500">#FFF5A623</Color>
    <Color x:Key="Amber400">#FFFFB627</Color>
    <Color x:Key="Success">#FF34D399</Color>
    <Color x:Key="Danger">#FFF87171</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Ink950}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Ink850}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource Ink800}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Ink700}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Ink600}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Ink50}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Ink300}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Ink400}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Ink500}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Amber500}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Amber400}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

    <!--
      The scrim behind the transport bar. Not a flat fill: a gradient that fades
      to nothing over the lower third of the frame, so the controls stay legible
      over a bright scene without putting a visible band across a dark one.
    -->
    <LinearGradientBrush x:Key="TransportScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#00000000" />
        <GradientStop Offset="0.55" Color="#66000000" />
        <GradientStop Offset="1.0" Color="#D9000000" />
    </LinearGradientBrush>

    <!--
      Overlay chips — the file-name pill, the track badge. Translucent rather
      than opaque so the frame beneath still reads as the subject.
    -->
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#E60A0A0B" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#4DFFFFFF" />

    <!-- Corner radii, matching the source design's 6 / 8 / 12 / 16 / 24 scale. -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!--
      Typography.

      The source design uses Cabinet Grotesk for display and Geist for UI and
      mono. Neither ships with Windows, so each family names a bundled font
      first and falls back to a Windows face that holds the same role. The app
      is fully legible without the bundled files present; see docs/UI_SPEC.md
      for how to add them.
    -->
    <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/CabinetGrotesk-Extrabold.ttf#Cabinet Grotesk, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontFamily">ms-appx:///Assets/Fonts/Geist-Regular.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">ms-appx:///Assets/Fonts/GeistMono-Regular.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="TextSizeCaption">12</x:Double>
    <x:Double x:Key="TextSizeBody">14</x:Double>
    <x:Double x:Key="TextSizeSubtitle">16</x:Double>
    <x:Double x:Key="TextSizeTitle">20</x:Double>

    <!--
      Transport metrics. The play button is deliberately much larger than its
      neighbours: in the source design it is the one filled amber circle on the
      whole surface, and everything else is a bare glyph.
    -->
    <x:Double x:Key="TransportButtonSize">36</x:Double>
    <x:Double x:Key="TransportPlayButtonSize">48</x:Double>
    <x:Double x:Key="SeekTrackHeight">4</x:Double>
    <x:Double x:Key="SeekTrackHoverHeight">6</x:Double>

</ResourceDictionary>
